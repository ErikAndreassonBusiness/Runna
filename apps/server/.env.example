PORT=4000
# Public URL of this server — Garmin redirects users back here after they authorise.
PUBLIC_URL=http://localhost:4000
DATABASE_PATH=stride.db
# Deep link the server redirects to once Garmin is connected.
APP_REDIRECT_URL=stride://garmin
# "mock" works without Garmin credentials; switch to "live" once approved.
GARMIN_MODE=mock
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
# Add ?token=<secret> to the webhook URLs you register with Garmin.
GARMIN_WEBHOOK_SECRET=
